// Cloudflare Workers config — one Worker serves both the static site (dist/)
// and the /api/* chat endpoints (worker/index.js).
//
// Deploy:
//   npx wrangler login                          (once)
//   npx wrangler secret put ANTHROPIC_API_KEY   (once — enables real AI chat)
//   npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamedverygood",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5"
  },
  // Membership database. Create in dashboard: Storage & Databases -> D1 ->
  // Create database -> name "gamedverygood-db", then paste its Database ID here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamedverygood-db",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
