// Cloudflare Workers config — one Worker serves both the static site (dist/)
// and the /api/* chat endpoints (worker/index.js).
//
// Deploy:
//   npx wrangler login                          (once)
//   npx wrangler secret put ANTHROPIC_API_KEY   (once — enables real AI chat)
//   npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamedverygood",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      // APIs always hit the Worker.
      "/api/*",
      // SEO: these page URLs go through the Worker so it can inject
      // per-page <title>/meta/OG/JSON-LD into the SPA shell (worker/index.js).
      // Static assets (/assets/*, favicon, ...) stay on the fast asset path.
      "/", "/robots.txt", "/sitemap.xml",
      "/catalog", "/game/*", "/topup", "/topup/*",
      "/history", "/tools", "/news", "/news/*", "/legal/*"
    ]
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5"
  },
  // Membership database. Create in dashboard: Storage & Databases -> D1 ->
  // Create database -> name "gamedverygood-db", then paste its Database ID here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamedverygood-db",
      "database_id": "0f9613db-e9f0-4e9b-80c6-557d75301244"
    }
  ],
  "observability": {
    "enabled": true
  }
}
