// Cloudflare Workers config — one Worker serves both the static site (dist/)
// and the /api/* chat endpoints (worker/index.js).
//
// Deploy:
//   npx wrangler login                          (once)
//   npx wrangler secret put ANTHROPIC_API_KEY   (once — enables real AI chat)
//   npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamedverygood",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5"
  },
  "observability": {
    "enabled": true
  }
}
