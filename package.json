{
  "name": "gamedverygood",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "gamedverygood.com — Thai gaming top-up portal (glassmorphism, Day/Night, AI chat)",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:server\"",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "express": "^4.21.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.120.0"
  }
}
